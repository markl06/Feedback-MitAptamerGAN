  "ernie": {
    "factory": "adapters.ernie_rna:LocalErnieRNA",
    "kwargs": {
      "checkpoint": "REPLACE_WITH_LOCAL_ERNIE_RNA_CHECKPOINT",
      "embedding_dim": 768,
      "device": "cpu",
      "pooling": "mean"
